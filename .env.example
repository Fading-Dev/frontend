# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Must match the backend's STELLAR_NETWORK / the network Freighter is set to
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Optional: deployed StellarTickets/blockchain `ticketing` contract (C...), same
# value as the backend's TICKETING_CONTRACT_ID. Enables the "View contract"
# stellar.expert link on published events.
NEXT_PUBLIC_TICKETING_CONTRACT_ID=
